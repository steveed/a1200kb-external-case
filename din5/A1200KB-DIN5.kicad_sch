	(text "CN17 (KB TEST): 1 KB_DATA, 2 KB_CLOCK, 3 KB_RESET, 4 U13 reset, 5 NC, 6 VCC, 7 GND. JP1 (bridged) holds U13 in reset; cut it to give the onboard controller back."
		(exclude_from_sim no)
		(at 20 250 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left)
		)
		(uuid "695fb9e6-4dc7-4251-8bcc-2baf51860864")
	)
	(text "Reset: KCLK held low (Ctrl-Amiga-Amiga) discharges C1 through R1 (tau 220ms); U1 then drives KB_RESET high after about 225ms."
		(exclude_from_sim no)
		(at 20 255 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left)
		)
		(uuid "a0279ad2-59c8-4156-a053-4500fbcb96f0")
	)
	(text "KB_RESET is taken as active-high (the A1200 pulls it down with 10k). If it proves active-low, fit a 74LVC1G17 (same pinout) for U1."
		(exclude_from_sim no)
		(at 20 260 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left)
		)
		(uuid "5b3c2196-0d39-48bd-b575-286213229d5b")
	)
	(text "DIN 5 (Amiga 2000/3000 keyboard, female, front view 3-1 across, 5-4 diagonal, 2 bottom): 1 KCLK, 2 KDAT, 3 NC, 4 GND + shell, 5 +5V."
		(exclude_from_sim no)
		(at 20 265 0)
